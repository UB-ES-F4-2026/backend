# Local development only. Defaults work without a .env file.
FRONTEND_PATH=../frontend
FRONTEND_PORT=5173
BACKEND_PORT=8000

# PostgreSQL: database and role are created when its volume is empty.
POSTGRES_DB=fintech
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_local
POSTGRES_PORT=5433

# pgAdmin login (separate from PostgreSQL credentials).
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_local_change_me
