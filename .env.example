# Desenvolupament local. Copia aquest fitxer a .env abans del primer inici.
# No sobreescriguis un .env existent ni el pugis a Git.
FRONTEND_PATH=../frontend
FRONTEND_PORT=5173
BACKEND_PORT=8000

# PostgreSQL crea la base i l'usuari quan el volum és buit.
# Canviar aquests valors no modifica les credencials d'un volum existent.
POSTGRES_DB=fintech
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_local
POSTGRES_PORT=5433

# Accés a pgAdmin, independent de les credencials de PostgreSQL.
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=fintech
